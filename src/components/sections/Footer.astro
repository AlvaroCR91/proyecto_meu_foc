---
import { THEFORK } from '../../lib/constants';
---

<!-- ══════════════════════════════════════
     FOOTER — datos de contacto
══════════════════════════════════════ -->
<footer class="ft">
  <div class="wrap">
    <div class="ft-grid">
      <div class="fcol">
        <img class="ft-logo" src="/assets/logo-white.png" alt="El Meu Foc" />
        <p style="margin-top:16px;font-style:italic;font-family:var(--serif);font-size:21px">
          El arroz como lenguaje. El fuego como memoria. Alicante como hogar.
        </p>
      </div>
      <div class="fcol">
        <h4>Visítanos</h4>
        <p>
          Calle Mexico, 25, local 8<br>
          03008 — Alicante<br>
          Mierc–Dom · 13:00–16:00<br>
          Viern–Sáb · 20:00–23:30<br>
          <em>Lunes y Martes cerrado</em>
        </p>
      </div>
      <div class="fcol">
        <h4>Contacto</h4>
        <p>
          <a href="tel:+34673694605">+34 673 69 46 05</a><br>
          <a href="mailto:restauranteelmeufoc@gmail.com">restauranteelmeufoc@gmail.com</a><br>
          <a href="https://g.page/elmeufoc/review" target="_blank" rel="noopener noreferrer">⭐ Déjanos tu reseña en Google</a>
        </p>
      </div>
      <div class="fcol">
        <h4>Reserva</h4>
        <p>
          <a href={THEFORK} target="_blank" rel="noopener noreferrer">Reservar en TheFork →</a><br>
          <a href="/carta-el-meu-foc.pdf" target="_blank" rel="noopener noreferrer">Ver la carta →</a><br>
          <a href="https://www.instagram.com/elmeufoc" target="_blank" rel="noopener noreferrer">@elmeufoc en Instagram</a>
        </p>
      </div>
    </div>
    <div class="copy">
      <span>© 2026 El Meu Foc · Restaurante · Alicante · <a class="copy-link" href="/aviso-legal">Aviso Legal</a> · <a class="copy-link" href="/politica-cookies">Política de Cookies</a></span>
      <span>Hecho con brasas, en Alicante.</span>
    </div>
  </div>
</footer>

<style>
  .copy-link { text-decoration: underline; text-underline-offset: 2px; }
  .copy-link:hover { color: var(--ember-2); }
</style>
