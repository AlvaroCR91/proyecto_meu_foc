---
import { THEFORK } from '../../lib/constants';
---

<!-- ══════════════════════════════════════
     HERO
══════════════════════════════════════ -->
<section class="hero surf-ember" id="top">
  <div class="bgslot">
    <div class="img-slot">
      <img src="/assets/sala-general.jpg" alt="Sala de El Meu Foc, restaurante de arroces y brasas en Alicante" />
    </div>
  </div>
  <div class="scrim"></div>
  <div class="sparks">
    <i style="left:10%;animation-duration:8s;animation-delay:.2s"></i>
    <i style="left:24%;animation-duration:9.5s;animation-delay:1.4s"></i>
    <i style="left:38%;animation-duration:7s;animation-delay:.7s"></i>
    <i style="left:52%;animation-duration:8.6s;animation-delay:2.1s"></i>
    <i style="left:66%;animation-duration:7.4s;animation-delay:.5s"></i>
    <i style="left:80%;animation-duration:9.1s;animation-delay:1.7s"></i>
    <i style="left:90%;animation-duration:7.8s;animation-delay:2.6s"></i>
  </div>
  <div class="hero-in wrap">
    <div class="eyebrow" style="margin-bottom:18px">Restaurante &nbsp;·&nbsp; Arroces y brasas &nbsp;·&nbsp; Alicante</div>
    <p class="hand kicker">des del cor —</p>
    <!-- H1 con keyword principal -->
    <h1 class="h1">
      <span class="hl">Arrocería y Brasería</span>
      <span class="hl ital">en Alicante.</span>
    </h1>
    <p class="sub">
      Fondos cocinados desde primera hora, producto fresco de la lonja y la huerta,
      brasa que se huele desde la puerta. Sin artificios: solo fuego y cariño.
    </p>
    <div class="cta-row">
      <a class="btn" href={THEFORK} target="_blank" rel="noopener noreferrer">
        Reservar mesa <span class="ar">→</span>
      </a>
      <a class="btn btn-ghost" href="/carta-el-meu-foc.pdf" target="_blank" rel="noopener noreferrer">Ver la carta</a>
    </div>
  </div>
</section>
