     RESTAURANTE / GALERÍA
══════════════════════════════════════ -->
<section class="section surf-paper" id="restaurante">
  <div class="veg veg-extra" data-side="left" style="top:16%;left:50%;width:clamp(98px,12vw,160px)">
    <img class="veg-img" src="/assets/veg-calabacin.png" alt="" />
  </div>
  <div class="veg" data-side="right" style="top:60%;left:50%;width:clamp(76px,9vw,120px)">
    <img class="veg-img" src="/assets/veg-ajo.png" alt="" />
  </div>
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">El Meu Foc</span>
      <h2 class="h2">Un lugar donde<br>sentirse a gusto.</h2>
      <p class="note">pasa, que las brasas ya están encendidas</p>
    </div>
    <div class="gallery">
      <div class="img-slot g-tall">
        <img src="/assets/sala-mesas-arte.jpg" alt="Sala interior de El Meu Foc con mesas puestas y cuadros en la pared" />
      </div>
      <div class="img-slot">
        <img src="/assets/detalle-mesa.jpg" alt="Detalle de mesa puesta en El Meu Foc" />
      </div>
      <div class="img-slot">
        <img src="/assets/carne-a-la-brasa.jpg" alt="Chuletón a la brasa sobre las ascuas en El Meu Foc" />
      </div>
      <div class="img-slot g-wide">
        <img src="/assets/arroz-la-muntanyeta.jpg" alt="Plato de arroz a la brasa con maridaje de vino en El Meu Foc" />
      </div>
      <div class="img-slot">
        <img src="/assets/postre-milhojas.jpg" alt="Milhojas de postre con crema y ralladura de naranja" />
      </div>
      <div class="img-slot">
        <img src="/assets/rincon-vinos.jpg" alt="Rincón de la bodega y selección de vinos de El Meu Foc" />
      </div>
      <div class="img-slot g-wide">
        <img src="/assets/fachada-terraza.jpg" alt="Fachada y terraza de El Meu Foc de noche" />
      </div>
    </div>
  </div>
</section>
