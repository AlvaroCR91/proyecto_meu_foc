---
import { Image } from 'astro:assets';
import vegCalabacin from '../../assets/veg-calabacin.png';
import vegAjo from '../../assets/veg-ajo.png';
import salaMesasArte from '../../assets/sala-mesas-arte.jpg';
import detalleMesa from '../../assets/detalle-mesa.jpg';
import carneALaBrasa from '../../assets/carne-a-la-brasa.jpg';
import arrozLaMuntanyeta from '../../assets/arroz-la-muntanyeta.jpg';
import postreMilhojas from '../../assets/postre-milhojas.jpg';
import rinconVinos from '../../assets/rincon-vinos.jpg';
import fachadaTerraza from '../../assets/fachada-terraza.jpg';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const tx = {
  es: {
    h2: 'Un lugar donde<br>sentirse a gusto.',
    note: 'pasa, que las brasas ya están encendidas',
    alt: {
      sala: 'Sala interior de El Meu Foc con mesas puestas y cuadros en la pared',
      mesa: 'Detalle de mesa puesta en El Meu Foc',
      carne: 'Chuletón a la brasa sobre las ascuas en El Meu Foc',
      arroz: 'Plato de arroz a la brasa con maridaje de vino en El Meu Foc',
      postre: 'Milhojas de postre con crema y ralladura de naranja',
      vinos: 'Rincón de la bodega y selección de vinos de El Meu Foc',
      fachada: 'Fachada y terraza de El Meu Foc de noche',
    },
  },
  en: {
    h2: 'A place where<br>you feel at home.',
    note: 'come on in, the embers are already lit',
    alt: {
      sala: 'Dining room at El Meu Foc with laid tables and paintings on the wall',
      mesa: 'Close-up of a laid table at El Meu Foc',
      carne: 'Bone-in rib steak over the embers at El Meu Foc',
      arroz: 'Rice dish from the grill paired with wine at El Meu Foc',
      postre: 'Mille-feuille dessert with cream and orange zest',
      vinos: 'Corner of the cellar and wine selection at El Meu Foc',
      fachada: 'Façade and terrace of El Meu Foc at night',
    },
  },
}[lang];
---

<!-- ══════════════════════════════════════
     RESTAURANTE / GALERÍA
══════════════════════════════════════ -->
<section class="section surf-paper" id="restaurante">
  <div class="veg veg-extra" data-side="left" style="top:16%;left:50%;width:clamp(98px,12vw,160px)">
    <Image class="veg-img" src={vegCalabacin} width={336} height={261} alt="" />
  </div>
  <div class="veg" data-side="right" style="top:60%;left:50%;width:clamp(76px,9vw,120px)">
    <Image class="veg-img" src={vegAjo} width={360} height={360} alt="" />
  </div>
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">El Meu Foc</span>
      <h2 class="h2" set:html={tx.h2} />
      <p class="note">{tx.note}</p>
    </div>
    <div class="gallery">
      <div class="img-slot g-tall">
        <Image src={salaMesasArte} width={1000} height={654} format="webp" quality={80} alt={tx.alt.sala} />
      </div>
      <div class="img-slot">
        <Image src={detalleMesa} width={700} height={953} format="webp" quality={80} alt={tx.alt.mesa} />
      </div>
      <div class="img-slot">
        <Image src={carneALaBrasa} width={900} height={675} format="webp" quality={80} alt={tx.alt.carne} />
      </div>
      <div class="img-slot g-wide">
        <Image src={arrozLaMuntanyeta} width={1200} height={1500} format="webp" quality={80} alt={tx.alt.arroz} />
      </div>
      <div class="img-slot">
        <Image src={postreMilhojas} width={700} height={875} format="webp" quality={80} alt={tx.alt.postre} />
      </div>
      <div class="img-slot">
        <Image src={rinconVinos} width={700} height={953} format="webp" quality={80} alt={tx.alt.vinos} />
      </div>
      <div class="img-slot g-wide">
        <Image src={fachadaTerraza} width={995} height={696} format="webp" quality={80} alt={tx.alt.fachada} />
      </div>
    </div>
  </div>
</section>
