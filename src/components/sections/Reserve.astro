---
import { THEFORK } from '../../lib/constants';
import type { Lang } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const tx = {
  es: {
    hand: 'reserva tu sitio en la mesa —',
    h2: 'Las brasas ya están<br>encendidas.',
    reservar: 'Reservar mesa',
    fork: 'Reserva gestionada con TheFork',
  },
  en: {
    hand: 'save your seat at the table —',
    h2: 'The embers are<br>already lit.',
    reservar: 'Book a table',
    fork: 'Bookings managed through TheFork',
  },
}[lang];
---

<!-- ══════════════════════════════════════
     RESERVE BAND
══════════════════════════════════════ -->
<section class="section surf-ember reserve">
  <div class="sparks">
    <i style="left:18%;animation-duration:8s;animation-delay:.3s"></i>
    <i style="left:36%;animation-duration:9.3s;animation-delay:1.6s"></i>
    <i style="left:54%;animation-duration:7.2s;animation-delay:.8s"></i>
    <i style="left:72%;animation-duration:8.7s;animation-delay:2.3s"></i>
    <i style="left:86%;animation-duration:7.7s;animation-delay:1.2s"></i>
  </div>
  <div class="wrap" style="position:relative;z-index:2">
    <p class="hand">{tx.hand}</p>
    <h2 class="h2" style="color:var(--cream);margin:8px 0 30px" set:html={tx.h2} />
    <a class="btn" href={THEFORK} target="_blank" rel="noopener noreferrer">
      {tx.reservar} <span class="ar">→</span>
    </a>
    <div class="fork">{tx.fork}</div>
  </div>
</section>
