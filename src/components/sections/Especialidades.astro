<!-- ══════════════════════════════════════
     ESPECIALIDADES
     H2: keyword "Brasería en Alicante"
     H3: "Restaurante de carne a la brasa Alicante" / "Arroz a la leña Alicante"
══════════════════════════════════════ -->
<section class="section surf-ember" id="especialidades">
  <div class="veg" data-side="left" style="top:20%;left:50%;width:clamp(98px,12vw,170px)">
    <img class="veg-img" src="/assets/veg-cebolla.png" alt="" />
  </div>
  <div class="veg veg-extra" data-side="right" style="top:64%;left:50%;width:clamp(112px,14vw,200px)">
    <img class="veg-img" src="/assets/veg-calabacin.png" alt="" />
  </div>
  <div class="sparks">
    <i style="left:14%;animation-duration:8.4s;animation-delay:.4s"></i>
    <i style="left:30%;animation-duration:9.2s;animation-delay:1.5s"></i>
    <i style="left:48%;animation-duration:7.1s;animation-delay:.9s"></i>
    <i style="left:64%;animation-duration:8.8s;animation-delay:2.2s"></i>
    <i style="left:82%;animation-duration:7.6s;animation-delay:1.1s"></i>
  </div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="sec-head sec-head--right">
      <span class="eyebrow">Lo que hacemos bien</span>
      <!-- H2: "Brasería en Alicante" -->
      <h2 class="h2" style="color:var(--cream)">Brasa y arroz —<br>las dos almas del local.</h2>
    </div>
    <div class="esp-grid">
      <div class="esp-bloque">
        <div class="esp-icon"></div>
        <!-- H3: "Restaurante de carne a la brasa Alicante" -->
        <h3>Restaurante de Carne a la Brasa en Alicante</h3>
        <p>
          Entrecots, presa ibérica, lubinas y ventrescas que entran al fuego
          con su tiempo, sin prisas. El humo hace el trabajo; nosotros,
          solo vigilamos el punto. Las brasas en El Meu Foc no se apagan
          hasta que el último plato sale a la sala.
        </p>
      </div>
      <div class="esp-bloque">
        <div class="esp-icon"></div>
        <!-- H3: "Arroz a la leña Alicante" -->
        <h3>Arroz en Alicante</h3>
        <p>
          El caldo entra al fuego antes de que abra el restaurante.
          El grano se cuece a su ritmo, hasta que el socarrat
          cruje solo. Así es el arroz en El Meu Foc: fondo artesanal,
          grano en su punto, tradición alicantina.
        </p>
      </div>
    </div>
    <!-- Platos insignia — texto para indexación SEO, sin precios -->
    <div class="signature-dishes">
      <span class="sd-label">Platos insignia de la casa</span>
      <ul class="sd-list">
        <li>Arroz Mi Foc</li>
        <li>Arroz Senyoret</li>
        <li>Rabo de toro y setas</li>
        <li>Chuletón madurado 30 días</li>
        <li>Presa ibérica a la brasa</li>
      </ul>
    </div>
  </div>
</section>
