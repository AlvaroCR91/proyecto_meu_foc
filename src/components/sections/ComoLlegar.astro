<!-- ══════════════════════════════════════
     CÓMO LLEGAR — SEO Local
     H2: "Dónde comer arroz en Alicante" + zona/barrio
══════════════════════════════════════ -->
<section class="section surf-paper" id="llegar" style="padding-top:0">
  <div class="veg veg-extra" data-side="left" style="top:34%;left:50%;width:clamp(86px,10vw,140px)">
    <img class="veg-img" src="/assets/veg-alcachofa.png" alt="" />
  </div>
  <div class="wrap">
    <div class="sec-head sec-head--right" style="margin-bottom:clamp(34px,4vw,56px)">
      <!-- eyebrow con keyword -->
      <span class="eyebrow">Arrocería en Alicante · Cómo llegar</span>
      <!-- H2 con keyword SEO local -->
      <h2 class="h2">Restaurante de Arroces y Brasas<br>en Babel, Alicante.</h2>
    </div>
    <div class="loc-grid">
      <div class="loc-info">
        <div class="info-row">
          <div class="it">
            <b>Dirección</b>
            <span>
              Calle Mexico, 25, local 8 · Babel<br>
              03008 — Alicante (Alacant)
            </span>
          </div>
        </div>
        <div class="info-row">
          <div class="it">
            <b>Horario</b>
            <span>
              Miercoles a Domingo · 13:00–16:00<br>
              Viernes y Sábado · 20:00–23:30<br>
              Lunes y Martes cerrado
            </span>
          </div>
        </div>
        <div class="info-row">
          <div class="it">
            <b>Reservas</b>
            <span>
              <a href="tel:+34673694605">+34 673 69 46 05</a><br>
              restauranteelmeufoc@gmail.com
            </span>
          </div>
        </div>
        <div class="info-row">
          <div class="it">
            <b>Síguenos</b>
            <span>@elmeufoc</span>
          </div>
        </div>
      </div>
      <div
        class="loc-map map-embed"
        style="width:100%;height:100%;min-height:340px"
        id="maps-embed"
        data-map-src="https://www.google.com/maps?q=Calle+Mexico+25+03008+Alicante&output=embed"
      >
        <div class="map-consent-gate" id="map-consent-gate">
          <p>Este mapa lo sirve Google y usa cookies de terceros.</p>
          <button type="button" class="btn cookie-btn" id="map-consent-accept">Aceptar y ver mapa</button>
        </div>
        <a
          class="map-overlay-link"
          href="https://www.google.com/maps/search/?api=1&query=Calle+Mexico+25+03008+Alicante"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Cómo llegar a El Meu Foc en Google Maps"
        ></a>
      </div>
    </div>
  </div>
</section>

<style>
  .map-consent-gate {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    padding: 24px;
    background:
      linear-gradient(135deg, rgba(199,90,38,.10), rgba(199,90,38,.04)),
      repeating-linear-gradient(45deg, rgba(43,30,22,.05) 0 10px, rgba(43,30,22,.02) 10px 20px);
    border: 1px dashed rgba(43,30,22,.25);
  }
  .map-consent-gate p {
    font-family: var(--body);
    font-size: 16px;
    color: var(--ink-soft);
    max-width: 32ch;
  }
  .map-consent-gate .btn {
    padding: 12px 24px;
    font-size: 15px;
  }
</style>

<script>
  function loadMap() {
    const container = document.getElementById('maps-embed');
    const gate = document.getElementById('map-consent-gate');
    if (!container || container.querySelector('iframe')) return;

    const src = container.getAttribute('data-map-src');
    if (!src) return;

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.title = 'Mapa de El Meu Foc';
    iframe.setAttribute('aria-hidden', 'true');
    iframe.tabIndex = -1;
    container.insertBefore(iframe, gate);
    gate?.remove();
  }

  const consent = (window as any).meufocCookieConsent?.get();
  if (consent === 'accepted') loadMap();

  document.getElementById('map-consent-accept')?.addEventListener('click', () => {
    (window as any).meufocCookieConsent?.set('accepted');
    loadMap();
  });

  document.addEventListener('meufoc:cookie-consent', (e: Event) => {
    if ((e as CustomEvent).detail === 'accepted') loadMap();
  });
</script>
