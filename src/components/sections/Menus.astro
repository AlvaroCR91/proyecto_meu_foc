---
import type { Lang } from '../../i18n/ui';
import { MENUS_PDF } from '../../lib/constants';

const { lang } = Astro.props as { lang: Lang };
const tx = {
  es: {
    eyebrow: 'Para compartir en mesa',
    h2: 'Menú Arrocero',
    note: 'pensado para disfrutar sin prisa, entre dos o más',
    unit: 'por persona &nbsp;·&nbsp; mínimo 2 personas',
    includes: [
      'Pan con alioli',
      'Entrante a elegir de la carta <em>(uno por persona)</em>',
      'Arroz a elegir de la carta <span class="star">*</span>',
      'Postre',
      'Café',
    ],
    menuNote: '<span class="star">*</span> Algunos arroces llevan un suplemento indicado en la carta.',
    tcats: '¿Buscas otra opción? Consulta el resto de nuestros menús',
    pdf: 'Ver el resto de menús (PDF)',
  },
  en: {
    eyebrow: 'To share at the table',
    h2: 'Rice Menu',
    note: 'made to be enjoyed slowly, for two or more',
    unit: 'per person &nbsp;·&nbsp; minimum 2 people',
    includes: [
      'Bread with alioli',
      'Starter of your choice from the menu <em>(one per person)</em>',
      'Rice dish of your choice from the menu <span class="star">*</span>',
      'Dessert',
      'Coffee',
    ],
    menuNote: '<span class="star">*</span> Some rice dishes carry a supplement, shown on the menu.',
    tcats: 'Looking for something else? Take a look at our other set menus',
    pdf: 'See our other set menus (PDF)',
  },
}[lang];
---

<!-- ══════════════════════════════════════
     MENÚS — menú arrocero cerrado
══════════════════════════════════════ -->
<section class="section surf-paper" id="menus">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <span class="eyebrow">{tx.eyebrow}</span>
      <h2 class="h2">{tx.h2}</h2>
      <p class="note">{tx.note}</p>
    </div>
    <div class="menu-card">
      <div class="menu-price">
        <span class="mp-amount">25 €</span>
        <span class="mp-unit" set:html={tx.unit} />
      </div>
      <ul class="menu-includes">
        {tx.includes.map((item) => <li set:html={item} />)}
      </ul>
      <p class="menu-note" set:html={tx.menuNote} />
    </div>
    <div class="teaser" style="margin-top:clamp(40px,5vw,64px)">
      <p class="tcats">{tx.tcats}</p>
      <div class="teaser-ctas">
        <a class="btn" href={MENUS_PDF[lang]} target="_blank" rel="noopener noreferrer">
          {tx.pdf} <span class="ar">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
