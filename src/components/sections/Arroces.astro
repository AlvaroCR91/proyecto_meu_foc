---
import { Image } from 'astro:assets';
import arrozMiFoc from '../../assets/arroz-mi-foc.jpg';
import rossellatSepiaGambas from '../../assets/rossellat-sepia-gambas.jpg';
import muntanyetaPlato from '../../assets/muntanyeta-plato.jpg';
import type { Lang } from '../../i18n/ui';
import { localePath } from '../../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const tx = {
  es: {
    eyebrow: 'Nuestra alma',
    h2: 'Dónde comer arroz<br>en Alicante — El Meu Foc.',
    note: 'cocidos a fuego lento, sin prisa',
    altMiFoc: 'Arroz Mi Foc con torreznos, setas y pimiento asado, servido en paella',
    altRossellat: 'Rossellat de sepia y gambas de El Meu Foc',
    altMuntanyeta: 'Arroz La Muntanyeta con secreto ibérico, garbanzos y ajetes tiernos',
    badge: 'Nuestro insignia',
    ddMiFoc: 'Torreznos, setas y pimiento asado.',
    ddRossellat: 'Fideuà con sepia y gambas.',
    ddMuntanyeta: 'Secreto ibérico, garbanzos y ajetes tiernos.',
    tcats: 'Entrantes · Arroces · Rossellat · Brasas · Vinos · Postres',
    carta: 'Descubra nuestra Carta Completa',
    bebidas: 'Carta de Bebidas (PDF)',
    teaserNote: 'La carta se actualiza a diario según el mercado y la lonja, para preservar siempre la frescura del producto.',
  },
  en: {
    eyebrow: 'Our soul',
    h2: 'Where to eat rice<br>in Alicante — El Meu Foc.',
    note: 'slow-cooked, unhurried',
    altMiFoc: 'Mi Foc rice with pork crackling, mushrooms and roasted pepper, served in a paella pan',
    altRossellat: 'El Meu Foc cuttlefish and prawn rossellat',
    altMuntanyeta: 'La Muntanyeta rice with Iberian pork secreto, chickpeas and tender garlic shoots',
    badge: 'Our signature dish',
    ddMiFoc: 'Pork crackling, mushrooms and roasted pepper.',
    ddRossellat: 'Fideuà with cuttlefish and prawns.',
    ddMuntanyeta: 'Iberian pork secreto, chickpeas and tender garlic shoots.',
    tcats: 'Starters · Rice dishes · Rossellat · Grill · Wines · Desserts',
    carta: 'Discover our Full Menu',
    bebidas: 'Drinks Menu (PDF)',
    teaserNote: 'The menu changes daily according to the market and the fish auction, so the produce is always at its freshest.',
  },
}[lang];
---

<!-- ══════════════════════════════════════
     ARROCES — muestra
     keyword "arrocería en Alicante" / "dónde comer arroz en Alicante"
══════════════════════════════════════ -->
<section class="section surf-ember" id="arroces">
  <div class="wrap" style="position:relative;z-index:2">
    <div class="sec-head">
      <span class="eyebrow">{tx.eyebrow}</span>
      <h2 class="h2" style="color:var(--cream)" set:html={tx.h2} />
      <p class="note">{tx.note}</p>
    </div>
    <div class="dish-grid">
      <article class="dish">
        <div class="img-slot" style="width:100%;height:clamp(240px,26vw,340px)">
          <Image src={arrozMiFoc} width={900} height={1126} format="webp" quality={80} alt={tx.altMiFoc} />
        </div>
        <span class="badge">{tx.badge}</span>
        <div class="dt">
          <span class="dn">Mi Foc</span>
          <span class="dp">19,5 €</span>
        </div>
        <p class="dd">{tx.ddMiFoc}</p>
      </article>
      <article class="dish">
        <div class="img-slot" style="width:100%;height:clamp(240px,26vw,340px)">
          <Image src={rossellatSepiaGambas} width={1000} height={830} format="webp" quality={80} alt={tx.altRossellat} />
        </div>
        <span class="badge" style="opacity:0;pointer-events:none">·</span>
        <div class="dt">
          <span class="dn">Rossellat de Sepia y Gambas</span>
          <span class="dp">23,0 €</span>
        </div>
        <p class="dd">{tx.ddRossellat}</p>
      </article>
      <article class="dish">
        <div class="img-slot" style="width:100%;height:clamp(240px,26vw,340px)">
          <Image src={muntanyetaPlato} width={700} height={1281} format="webp" quality={80} alt={tx.altMuntanyeta} />
        </div>
        <span class="badge" style="opacity:0;pointer-events:none">·</span>
        <div class="dt">
          <span class="dn">La Muntanyeta</span>
          <span class="dp">19,5 €</span>
        </div>
        <p class="dd">{tx.ddMuntanyeta}</p>
      </article>
    </div>
    <div class="teaser" style="margin-top:clamp(40px,5vw,64px)">
      <p class="tcats">{tx.tcats}</p>
      <div class="teaser-ctas">
        <a class="btn btn-ghost" href={localePath(lang, '/carta')}>
          {tx.carta} <span class="ar">→</span>
        </a>
        <a class="btn btn-ghost" href="/bebidas-el-meu-foc.pdf" target="_blank" rel="noopener noreferrer">
          {tx.bebidas} <span class="ar">→</span>
        </a>
      </div>
    </div>
    <p class="teaser-note">{tx.teaserNote}</p>
  </div>
</section>
