---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import EventList from '../../components/eventos/EventList';
import SubscribeForm from '../../components/eventos/SubscribeForm';
import Lightbox from '../../components/sections/Lightbox.astro';
import '../../styles/landing.css';
import '../../styles/eventos.css';
import muestra from '../../assets/muestra.jpeg';
import cataMaridaje from '../../assets/cata_maridaje.jpeg';
import tusSentidos from '../../assets/tus_sentidos.jpeg';
import cenaCata from '../../assets/cena_cata.jpg';
import menuSolidario from '../../assets/menu_solidario.jpeg';
import cenaCata2 from '../../assets/cena_cata_2.jpg';
---

<Layout
  title="Eventos y catas en Alicante | El Meu Foc"
  description="Eventos en El Meu Foc, arrocería y brasería en Alicante: catas de vino, cenas maridaje y jornadas gastronómicas. Consulta las próximas fechas."
  alternates={false}
>

<div class="wrap">
  <a class="back-link" href="/">← Volver a la web</a>
</div>

<section class="section surf-paper">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <span class="eyebrow">El Meu Foc</span>
      <h1 class="h2">Nuestros <span class="ital">eventos</span></h1>
      <p class="lead-p">Jornadas gastronómicas, catas y noches especiales alrededor del fuego y el arroz.</p>
    </div>
  </div>
</section>

<section class="section surf-ember">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <span class="eyebrow">Próximas fechas</span>
      <h2 class="h2" style="color:var(--cream)">Reserva la fecha</h2>
    </div>
    <EventList client:load />
  </div>
</section>

<section class="section surf-paper">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <span class="eyebrow">Momentos de la casa</span>
      <h2 class="h2">Eventos anteriores</h2>
    </div>
    <div class="gallery" id="eventos-gallery" style="margin-top:48px">
      <div class="img-slot g-wide">
        <Image src={muestra} width={800} height={1732} format="webp" quality={80} alt="Selección de tapas y cervezas artesanas servida en una cata de El Meu Foc" />
      </div>
      <div class="img-slot">
        <Image src={cataMaridaje} width={787} height={1116} format="webp" quality={80} alt="Cartel del evento Cata de Maridaje en El Meu Foc" />
      </div>
      <div class="img-slot g-tall">
        <Image src={tusSentidos} width={800} height={1422} format="webp" quality={80} alt="Cartel del evento &quot;Un banquete que despierta tus sentidos&quot; en El Meu Foc" />
      </div>
      <div class="img-slot">
        <Image src={cenaCata} width={800} height={1132} format="webp" quality={80} alt="Cartel de la Cena con Cata de Vinos, en colaboración con Bodega Las Virtudes" />
      </div>
      <div class="img-slot">
        <Image src={menuSolidario} width={800} height={1000} format="webp" quality={80} alt="Cartel del Menú Solidario a beneficio de la protectora de animales Asoka el Grande" />
      </div>
      <div class="img-slot">
        <Image src={cenaCata2} width={800} height={1000} format="webp" quality={80} alt="Cartel de la Cena con Cata de Vinos — Un camino, dos historias" />
      </div>
    </div>
  </div>
</section>

<section class="section surf-paper">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <span class="eyebrow">No te lo pierdas</span>
      <h2 class="h2">Entérate antes que nadie</h2>
    </div>
    <SubscribeForm client:load />
  </div>
</section>

<Lightbox />

</Layout>

<script>
  // Igual que el lightbox de la home, pero con delegación de eventos: las
  // imágenes de los eventos las pinta React después de cargar la página, así
  // que no existen todavía cuando este script arranca.
  (function () {
    const lightboxEl = document.getElementById('lightbox');
    const lbImgEl = lightboxEl?.querySelector('img');
    if (!lightboxEl || !lbImgEl) return;

    const lightbox: HTMLElement = lightboxEl;
    const lbImg: HTMLImageElement = lbImgEl;
    let isOpen = false;

    function open(src: string, alt: string) {
      lbImg.src = src;
      lbImg.alt = alt;
      lightbox.classList.add('open');
      if (!isOpen) {
        isOpen = true;
        history.pushState({ lightbox: true }, '');
      }
    }

    function close() {
      if (!isOpen) return;
      lightbox.classList.remove('open');
      isOpen = false;
      if (history.state && history.state.lightbox) {
        history.back();
      }
    }

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLImageElement>(
        '.event-card-image, .gallery .img-slot img'
      );
      if (target) open(target.src, target.alt);
    });

    lightbox.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    window.addEventListener('popstate', () => {
      if (isOpen) {
        lightbox.classList.remove('open');
        isOpen = false;
      }
    });
  })();
</script>

<script>
  // Cuando la fecha de un evento con foto ya ha pasado, su imagen se suma
  // sola a "Eventos anteriores" (el lightbox de arriba ya funciona con
  // delegación de eventos, así que estas imágenes añadidas después también
  // abren el visor al hacer clic sin nada más que hacer aquí).
  import { getEventosPasados } from '../../components/eventos/api';

  (async function () {
    const gallery = document.getElementById('eventos-gallery');
    if (!gallery) return;

    const { ok, data } = await getEventosPasados();
    if (!ok || !data.eventos?.length) return;

    for (const evento of data.eventos) {
      if (!evento.imagen_placeholder) continue;
      const slot = document.createElement('div');
      slot.className = 'img-slot';
      const img = document.createElement('img');
      img.src = evento.imagen_placeholder;
      img.alt = `Foto del evento ${evento.titulo}`;
      img.loading = 'lazy';
      slot.appendChild(img);
      gallery.appendChild(slot);
    }
  })();
</script>
