---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav';
import '../styles/landing.css';

import Hero from '../components/sections/Hero.astro';
import Historia from '../components/sections/Historia.astro';
import Especialidades from '../components/sections/Especialidades.astro';
import Arroces from '../components/sections/Arroces.astro';
import Menus from '../components/sections/Menus.astro';
import Restaurante from '../components/sections/Restaurante.astro';
import ComoLlegar from '../components/sections/ComoLlegar.astro';
import Reserve from '../components/sections/Reserve.astro';
import Finale from '../components/sections/Finale.astro';
import Footer from '../components/sections/Footer.astro';
import Lightbox from '../components/sections/Lightbox.astro';
---

<Layout
  title="El Meu Foc | Arrocería y Brasería en Alicante"
  description="Arrocería y brasería en Alicante. Arroz a la leña con socarrat auténtico y pescados frescos a la brasa. Reserva en El Meu Foc."
>

<!-- NAV — React island con scroll state -->
<Nav logoSrc="/assets/logo-white.png" client:load />

<Hero />
<Historia />
<Especialidades />
<Arroces />
<Menus />
<Restaurante />
<ComoLlegar />
<Reserve />
<Finale />
<Footer />
<Lightbox />

</Layout>

<script>
/* ── header scroll ── */
// handled by React Nav island

/* ── lightbox de la galería ── */
(function () {
  const lightbox = document.getElementById('lightbox');
  const lbImg = lightbox?.querySelector('img');
  if (!lightbox || !lbImg) return;

  let isOpen = false;

  function open(src: string, alt: string) {
    lbImg.src = src;
    lbImg.alt = alt;
    lightbox.classList.add('open');
    if (!isOpen) {
      isOpen = true;
      // añade una entrada al historial: así el botón "atrás" cierra la imagen
      // en vez de sacar al usuario de la página
      history.pushState({ lightbox: true }, '');
    }
  }

  function close() {
    if (!isOpen) return;
    lightbox.classList.remove('open');
    isOpen = false;
    if (history.state && history.state.lightbox) {
      history.back();
    }
  }

  document.querySelectorAll('.gallery .img-slot img').forEach(img => {
    img.addEventListener('click', () => {
      open((img as HTMLImageElement).src, (img as HTMLImageElement).alt);
    });
  });

  // clic en cualquier punto del lightbox (fondo o la propia foto) lo cierra
  lightbox.addEventListener('click', close);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') close();
  });
  window.addEventListener('popstate', () => {
    if (isOpen) {
      lightbox.classList.remove('open');
      isOpen = false;
    }
  });
})();

/* ── scroll reveal ── */
(function () {
  document.querySelectorAll('.img-slot').forEach(el => el.classList.add('rv-img'));

  const blockSel = '.eyebrow,.hand,.h1,.h2,.lead-p,.creed,.sign,.rule-ember,.sec-head,.badge,.dish .dt,.dish .dd,.cta-row,.teaser,.info-row,.reserve .btn,.fork,.ft-grid,.copy,.esp-bloque';
  document.querySelectorAll('section, footer').forEach(sec => {
    if (sec.classList.contains('finale')) return;
    let i = 0;
    sec.querySelectorAll(blockSel).forEach(el => {
      if (el.closest('.sec-head') && !el.classList.contains('sec-head')) return;
      el.classList.add('rv');
      (el as HTMLElement).style.transitionDelay = Math.min(i * 80, 420) + 'ms';
      i++;
    });
    let j = 0;
    sec.querySelectorAll('.img-slot').forEach(el => {
      (el as HTMLElement).style.transitionDelay = Math.min(j * 110, 440) + 'ms';
      j++;
    });
  });

  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

  const targets = document.querySelectorAll('.rv, .rv-img');
  void document.body.offsetHeight;
  requestAnimationFrame(() => {
    targets.forEach(el => el.classList.add('anim'));
    targets.forEach(el => io.observe(el));
  });
})();

/* ── flying vegetables ── */
(function () {
  const vegs = Array.from(document.querySelectorAll<HTMLElement>('.veg'));
  if (!vegs.length) return;
  const finaleEl = document.querySelector<HTMLElement>('.finale');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    vegs.forEach(v => v.style.opacity = '0');
    if (finaleEl) finaleEl.classList.add('in');
    return;
  }

  const anchors = new Map<HTMLElement, number>();
  function measure() {
    vegs.forEach(v => { v.style.transform = 'none'; });
    void document.body.offsetHeight;
    vegs.forEach(v => {
      const r = v.getBoundingClientRect();
      anchors.set(v, r.top + window.scrollY + r.height / 2);
    });
    update();
  }

  function update() {
    const vh = window.innerHeight, vw = window.innerWidth, sy = window.scrollY;
    let fp = 0;
    if (finaleEl) {
      const ftop = finaleEl.getBoundingClientRect().top + sy;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
      const startScroll = ftop - vh;
      fp = Math.max(0, Math.min(1, (sy - startScroll) / Math.max(1, maxScroll - startScroll)));
    }
    vegs.forEach(v => {
      const isFin = v.classList.contains('veg-finale');
      let p = isFin
        ? Math.min(1, fp / 0.6)
        : (() => { const c = (anchors.get(v) || 0) - sy; return Math.max(0, Math.min(1, (vh - c) / (vh * 0.9))); })();
      const dir = v.getAttribute('data-side') === 'left' ? -1 : 1;
      const startX = dir * (vw * 0.5 + 280);
      const ex = 1 - Math.pow(1 - p, 2);
      const fx = (1 - ex) * startX;
      const arc = -Math.sin(p * Math.PI) * (vh * 0.085);
      const fall = p > 0.72 ? Math.pow((p - 0.72) / 0.28, 2) * (vh * 0.16) : 0;
      const fy = arc + fall;
      const rot = dir * (p * 150 - 22);
      const sIn = 0.55 + 0.45 * Math.min(1, p / 0.3);
      const sOut = p > 0.74 ? Math.max(0.3, 1 - ((p - 0.74) / 0.26) * 0.72) : 1;
      const sc = sIn * sOut;
      const op = p < 0.12 ? p / 0.12 : p > 0.78 ? Math.max(0, 1 - (p - 0.78) / 0.22) : 1;
      v.style.transform = `translateX(calc(-50% + ${fx.toFixed(1)}px)) translateY(${fy.toFixed(1)}px) rotate(${rot.toFixed(1)}deg) scale(${sc.toFixed(3)})`;
      v.style.opacity = op.toFixed(3);
    });
    if (finaleEl) {
      if (fp > 0.66) finaleEl.classList.add('in');
      else if (fp < 0.55) finaleEl.classList.remove('in');
    }
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(() => { update(); ticking = false; }); }
  }, { passive: true });
  window.addEventListener('resize', measure);
  window.addEventListener('load', measure);
  measure();
})();
</script>
