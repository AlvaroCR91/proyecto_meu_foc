---
import Layout from '../layouts/Layout.astro';
import '../styles/carta.css';
---

<Layout
  title="Carta — El Meu Foc | Arroces y Brasas en Alicante"
  description="Carta completa de El Meu Foc: entrantes, arroces a la leña, brasas de carne y pescado, postres y vinos. Restaurante en Alicante."
>

<div class="stage" id="stage">
  <a class="back-link" href="/">← Volver a la web</a>
  <div class="feed" id="feed">

    <!-- ══ 01 PORTADA ══ -->
    <section class="page ember" data-screen-label="01 · Portada">
      <div class="sparks">
        <i style="left:12%;animation-duration:7.5s;animation-delay:.2s"></i>
        <i style="left:22%;animation-duration:9s;animation-delay:1.4s"></i>
        <i style="left:34%;animation-duration:6.6s;animation-delay:.7s"></i>
        <i style="left:46%;animation-duration:8.4s;animation-delay:2.1s"></i>
        <i style="left:56%;animation-duration:7s;animation-delay:.4s"></i>
        <i style="left:67%;animation-duration:9.6s;animation-delay:1.1s"></i>
        <i style="left:78%;animation-duration:6.9s;animation-delay:2.6s"></i>
        <i style="left:88%;animation-duration:8.1s;animation-delay:.9s"></i>
      </div>
      <div class="inner" style="align-items:center;text-align:center;justify-content:space-between;padding-top:120px;padding-bottom:148px">
        <div style="display:flex;flex-direction:column;align-items:center;gap:34px">
          <img src="/assets/logo-white.png" alt="El Meu Foc" style="width:360px;display:block" />
          <div class="eyebrow" style="white-space:nowrap;letter-spacing:.3em">Restaurante &nbsp;·&nbsp; Alicante</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:30px">
          <div class="kicker-hand">des del cor —</div>
          <h1 class="h-title" style="font-size:118px;color:var(--cream)">
            Cocinamos<br>con fuego,<br>
            <span style="font-style:italic;color:var(--ember-2)">servimos<br>con amor.</span>
          </h1>
          <div class="coal" style="margin-top:6px"></div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:48px">
          <p class="margin-note" style="font-size:46px;color:var(--cream);opacity:.92">«Pasa, que el fuego ya está encendido.»</p>
          <div class="eyebrow" style="color:#c98b5a;font-size:23px;white-space:nowrap;letter-spacing:.16em">Arroces &nbsp;·&nbsp; Brasas &nbsp;·&nbsp; Producto de territorio</div>
        </div>
      </div>
    </section>
    <div class="cap"><span>01</span> &nbsp;·&nbsp; Portada</div>

    <!-- ══ 02 NUESTRA HISTORIA ══ -->
    <section class="page paper" data-screen-label="02 · Nuestra historia">
      <div class="frame"></div>
      <div class="inner">
        <div style="display:flex;justify-content:space-between;align-items:flex-start">
          <div>
            <div class="eyebrow">Nuestra casa</div>
            <h2 class="h-title" style="font-size:88px;margin-top:18px">Empezamos<br>con poco.</h2>
          </div>
          <img src="/assets/logo-ink.png" alt="El Meu Foc" style="width:150px;opacity:.92;display:block" />
        </div>
        <hr class="rule-ember" style="margin:40px 0 50px" />
        <div style="display:flex;gap:56px;align-items:flex-start">
          <div style="flex:1">
            <p class="letter-p drop">
              Una brasa, un puñado de arroz y las ganas de dar de comer como se da en casa:
              con tiempo, con las manos y con cariño. De ahí venimos.
            </p>
            <p class="letter-p">
              Cada plato que sale de esta cocina lleva dentro el madrugón de quien lo prepara,
              el respeto por el producto de nuestra tierra y el deseo sincero de que en
              tu mesa te sientas cuidado.
            </p>
            <p class="letter-p" style="font-family:var(--serif);font-style:italic;font-size:40px;color:var(--ink)">
              No cocinamos para impresionar.<br>Cocinamos para cuidarte.
            </p>
          </div>
          <figure style="width:300px;flex:none;display:flex;flex-direction:column;gap:14px">
            <div class="img-slot" style="width:300px;height:420px">
              <span class="img-slot-label">Foto: las manos / el cocinero junto al fuego</span>
            </div>
            <figcaption class="photo-cap">Las manos que cocinan tu mesa</figcaption>
          </figure>
        </div>
        <div style="margin-top:auto;display:flex;flex-direction:column;gap:30px">
          <hr class="rule" />
          <p class="creed">El arroz como lenguaje. El fuego como memoria.<br>Alicante como hogar.</p>
          <div style="display:flex;justify-content:space-between;align-items:flex-end">
            <p class="sign">— La familia de El Meu Foc</p>
            <p class="margin-note" style="font-size:46px;transform:rotate(-6deg)">fet amb amor</p>
          </div>
        </div>
      </div>
    </section>
    <div class="cap"><span>02</span> &nbsp;·&nbsp; Una carta para ti</div>

    <!-- ══ 03 ENTRANTES ══ -->
    <section class="page paper" data-screen-label="03 · Entrantes">
      <div class="frame"></div>
      <div class="inner">
        <img src="/assets/logo-ink.png" alt="El Meu Foc" style="width:128px;align-self:center;margin-bottom:30px;display:block" />
        <div class="section-head" style="justify-content:center">
          <h2 class="section-title" style="font-size:74px">Entrantes</h2>
        </div>
        <p class="margin-note" style="font-size:38px;text-align:center;margin-top:4px">para empezar, para compartir</p>
        <div class="cols" style="justify-content:flex-end;margin:34px 0 6px">
          <div class="c">½ Ración</div>
          <div class="c">Ración</div>
        </div>
        <hr class="rule" />
        <div style="margin-top:6px">
          <div class="item"><span class="nm">Pan <em>(unidad)</em></span><span class="lead"></span><span class="pr two"><span class="half"></span><span class="full">1,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Pan sin gluten <em>(unidad)</em></span><span class="lead"></span><span class="pr two"><span class="half"></span><span class="full">1,5&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Tomate y alioli</span><span class="lead"></span><span class="pr two"><span class="half"></span><span class="full">2,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Ensaladilla rusa</span><span class="lead"></span><span class="pr two"><span class="half">4,7&nbsp;€</span><span class="full">8,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Marinera en pan integral con anchoa ahumada</span><span class="lead"></span><span class="pr two"><span class="half"></span><span class="full">4,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Patatas bravas</span><span class="lead"></span><span class="pr two"><span class="half">5,9&nbsp;€</span><span class="full">10,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Tomate rosa con ventresca de atún</span><span class="lead"></span><span class="pr two"><span class="half">7,0&nbsp;€</span><span class="full">12,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Tomate rosa con selección de salazones</span><span class="lead"></span><span class="pr two"><span class="half">8,0&nbsp;€</span><span class="full">14,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Torreznos de Soria 100% a la brasa</span><span class="lead"></span><span class="pr two"><span class="half">8,0&nbsp;€</span><span class="full">13,5&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Pericana</span><span class="lead"></span><span class="pr two"><span class="half">9,0&nbsp;€</span><span class="full">16,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Verduras de temporada a la brasa</span><span class="lead"></span><span class="pr two"><span class="half"></span><span class="full">13,0&nbsp;€</span></span></div>
          <div class="item"><span class="nm">Ensalada de brotes tiernos<span class="desc">tomate cherry confitado, requesón de cabra, piñones garrapiñados y vinagreta de naranja</span></span><span class="lead"></span><span class="pr two"><span class="half">7,5&nbsp;€</span><span class="full">12,0&nbsp;€</span></span></div>
        </div>
        <div class="section-head" style="margin-top:46px;align-items:center;gap:16px">
          <span class="coal"></span>
          <h3 class="section-title" style="font-size:46px">Entrantes especiales</h3>
        </div>
        <p class="margin-note" style="font-size:34px;margin:2px 0 10px">de la casa, con mimo</p>
        <div>
          <div class="item"><span class="nm">Carpaccio de ternera al estilo foc</span><span class="lead"></span><span class="pr">16,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Atún de Sorra con esgarraet de pimientos asados</span><span class="lead"></span><span class="pr">18,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Vieiras del Pacífico con aceite de perejil y lima <em>(unidad)</em></span><span class="lead"></span><span class="pr">3,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Mejillones al estilo foc <em>(1 kilo)</em></span><span class="lead"></span><span class="pr">18,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Langostino con alcachofa confitada</span><span class="lead"></span><span class="pr">20,0&nbsp;€</span></div>
        </div>
        <p class="foot-note center" style="margin-top:auto">* Platos no incluidos en el menú arrocero</p>
      </div>
    </section>
    <div class="cap"><span>03</span> &nbsp;·&nbsp; Entrantes</div>

    <!-- ══ 04 ARROCES ══ -->
    <section class="page paper" data-screen-label="04 · Arroces">
      <div class="frame"></div>
      <div class="inner" style="padding:80px 92px">
        <div style="display:flex;justify-content:space-between;align-items:flex-end">
          <div>
            <div class="eyebrow">Nuestra alma</div>
            <h2 class="h-title" style="font-size:96px;margin-top:10px">Arroces</h2>
          </div>
          <p class="margin-note" style="font-size:40px;transform:rotate(-5deg);max-width:300px;text-align:right">
            el lenguaje<br>de nuestra tierra
          </p>
        </div>
        <figure style="margin:30px 0 26px;display:flex;flex-direction:column;gap:12px">
          <div class="img-slot" style="width:100%;height:300px">
            <span class="img-slot-label">Foto: arroz MI FOC a la leña, en la paella</span>
          </div>
        </figure>
        <div class="insignia">
          <div class="item" style="padding:4px 0">
            <span class="nm">MI FOC<span class="desc">nuestro arroz insignia · torreznos, setas y pimiento asado</span></span>
            <span class="lead"></span><span class="pr">19,5&nbsp;€</span>
          </div>
        </div>
        <div style="margin-top:6px">
          <div class="item"><span class="nm">Magro y verduras</span><span class="lead"></span><span class="pr">19,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Senyoret</span><span class="lead"></span><span class="pr">18,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Pulpo y tomate seco</span><span class="lead"></span><span class="pr">19,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Rabo de toro y setas</span><span class="lead"></span><span class="pr">19,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Negro de sepia y alioli</span><span class="lead"></span><span class="pr">18,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Brisa Marina <em>· ventresca de atún, shiitake, katsuobushi</em></span><span class="lead"></span><span class="pr">19,5&nbsp;€</span></div>
          <div class="item"><span class="nm">La Muntanyeta <em>· secreto ibérico, garbanzos, ajetes tiernos</em></span><span class="lead"></span><span class="pr">19,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Del Huerto <em>· verduras asadas a la brasa</em></span><span class="lead"></span><span class="pr">16,9&nbsp;€</span></div>
        </div>
        <div class="section-head" style="margin-top:30px;align-items:center;gap:16px">
          <span class="coal"></span>
          <h3 class="section-title" style="font-size:44px">Arroces especiales <span class="star">**</span></h3>
        </div>
        <div style="margin-top:2px">
          <div class="item"><span class="nm">Fondo Marino <em>· vieiras del Pacífico y buey de mar</em></span><span class="lead"></span><span class="pr">23,0&nbsp;€</span></div>
          <div class="item"><span class="nm">El nieto consentido <em>· costilla de ternera a baja Tª y espárragos</em></span><span class="lead"></span><span class="pr">20,0&nbsp;€</span></div>
          <div class="item"><span class="nm">El viejo puerto <em>· rape y carpaccio de gambas</em></span><span class="lead"></span><span class="pr">25,0&nbsp;€</span></div>
          <div class="item"><span class="nm">La casa vieja <em>· nuestra versión de arroz al horno</em></span><span class="lead"></span><span class="pr">22,0&nbsp;€</span></div>
        </div>
        <p class="foot-note center" style="margin-top:auto">
          <span class="star">**</span> Suplemento de 3&nbsp;€ p.p. en el menú arrocero &nbsp;·&nbsp; consulta también nuestro <em>rossellat</em>
        </p>
      </div>
    </section>
    <div class="cap"><span>04</span> &nbsp;·&nbsp; Arroces · nuestra alma</div>

    <!-- ══ 05 BRASAS ══ -->
    <section class="page paper" data-screen-label="05 · Brasas">
      <div class="frame"></div>
      <div class="inner">
        <img src="/assets/logo-ink.png" alt="El Meu Foc" style="width:128px;align-self:center;margin-bottom:26px;display:block" />
        <div class="section-head" style="justify-content:center">
          <h2 class="section-title" style="font-size:74px">Brasas</h2>
        </div>
        <p class="margin-note" style="font-size:38px;text-align:center;margin-top:4px">al fuego, sin prisa</p>
        <div class="section-head" style="margin-top:44px;align-items:center;gap:16px">
          <span class="coal"></span><h3 class="section-title" style="font-size:44px">Carnes</h3>
        </div>
        <hr class="rule" style="margin-top:10px" />
        <div>
          <div class="item"><span class="nm">Solomillo de ternera</span><span class="lead"></span><span class="pr">28,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Entrecot</span><span class="lead"></span><span class="pr">22,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Chuletón de 1 kilo</span><span class="lead"></span><span class="pr">44,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Presa ibérica</span><span class="lead"></span><span class="pr">26,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Costilla de ternera a baja temperatura</span><span class="lead"></span><span class="pr">24,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Secreto ibérico</span><span class="lead"></span><span class="pr">24,0&nbsp;€</span></div>
        </div>
        <div class="section-head" style="margin-top:36px;align-items:center;gap:16px">
          <span class="coal"></span><h3 class="section-title" style="font-size:44px">Pescados</h3>
        </div>
        <hr class="rule" style="margin-top:10px" />
        <div>
          <div class="item"><span class="nm">Lubina</span><span class="lead"></span><span class="pr">22,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Sepia</span><span class="lead"></span><span class="pr">19,5&nbsp;€</span></div>
          <div class="item"><span class="nm">Pata de pulpo <em>(300 g)</em></span><span class="lead"></span><span class="pr">26,0&nbsp;€</span></div>
          <div class="item"><span class="nm">Ventresca de atún rojo</span><span class="lead"></span><span class="pr">32,0&nbsp;€</span></div>
        </div>
        <div class="section-head" style="margin-top:36px;align-items:center;gap:16px">
          <span class="coal"></span><h3 class="section-title" style="font-size:44px">Brasas especiales</h3>
        </div>
        <div style="margin-top:6px">
          <div class="item"><span class="nm">Pescado de temporada</span><span class="lead"></span><span class="pr" style="width:auto;font-style:italic;color:var(--ink-soft)">según mercado</span></div>
          <div class="item"><span class="nm">Chuletón madurado 30 días <em>(1 kilo)</em></span><span class="lead"></span><span class="pr" style="width:auto;font-style:italic;color:var(--ink-soft)">según mercado</span></div>
        </div>
        <p class="foot-note center" style="margin-top:auto">
          Todos los platos de brasa se acompañan de una guarnición:<br>patatas, ensalada o verduras.
        </p>
      </div>
    </section>
    <div class="cap"><span>05</span> &nbsp;·&nbsp; Brasas</div>

    <!-- ══ 06 CIERRE ══ -->
    <section class="page ember" data-screen-label="06 · Cierre">
      <div class="sparks">
        <i style="left:16%;animation-duration:8s;animation-delay:.3s"></i>
        <i style="left:28%;animation-duration:9.4s;animation-delay:1.7s"></i>
        <i style="left:41%;animation-duration:6.8s;animation-delay:.9s"></i>
        <i style="left:53%;animation-duration:8.6s;animation-delay:2.3s"></i>
        <i style="left:64%;animation-duration:7.2s;animation-delay:.5s"></i>
        <i style="left:74%;animation-duration:9.1s;animation-delay:1.3s"></i>
        <i style="left:84%;animation-duration:7.6s;animation-delay:2.8s"></i>
      </div>
      <div class="inner" style="align-items:center;text-align:center;justify-content:center;gap:60px">
        <p class="kicker-hand" style="font-size:64px">gràcies de tot cor —</p>
        <h2 class="h-title" style="font-size:86px;line-height:1.04;color:var(--cream);white-space:nowrap">
          El arroz como<br><span style="font-style:italic;color:var(--ember-2)">lenguaje.</span><br>
          El fuego como<br><span style="font-style:italic;color:var(--ember-2)">memoria.</span><br>
          Alicante como<br><span style="font-style:italic;color:var(--ember-2)">hogar.</span>
        </h2>
        <div class="coal"></div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:26px;margin-top:8px">
          <img src="/assets/logo-white.png" alt="El Meu Foc" style="width:210px;display:block" />
          <div class="eyebrow" style="color:#c98b5a">Hasta pronto &nbsp;·&nbsp; gracias por preferirnos</div>
        </div>
      </div>
    </section>
    <div class="cap"><span>06</span> &nbsp;·&nbsp; Cierre</div>

  </div><!-- /feed -->
</div><!-- /stage -->

</Layout>

<script>
(function () {
  const feed = document.getElementById('feed') as HTMLElement | null;
  const stage = document.getElementById('stage') as HTMLElement | null;
  function fit() {
    if (!feed || !stage) return;
    const s = Math.min(1, (window.innerWidth - 48) / 1080);
    feed.style.transform = `scale(${s})`;
    stage.style.height = feed.offsetHeight * s + 'px';
  }
  window.addEventListener('resize', fit);
  if (document.fonts?.ready) document.fonts.ready.then(fit);
  window.addEventListener('load', fit);
  fit();
})();
</script>
