---
import CookieConsent from '../components/CookieConsent.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import RestaurantSchema from '../components/RestaurantSchema.astro';
import { getLang, altPath } from '../i18n/utils';
// fuentes de reserva ajustadas: evitan que el texto salte al cargar las de Google
import '../styles/font-fallbacks.css';

export interface Props {
  title?: string;
  description?: string;
  robots?: string;
  /** false en páginas sin versión en el otro idioma (no se ponen enlaces hreflang) */
  alternates?: boolean;
}
const {
  title = 'El Meu Foc | Arrocería y Brasería en Alicante',
  description = 'Arrocería y brasería en Alicante. Arroz con socarrat, carnes y pescados frescos a la brasa de carbón. Reserva tu mesa en El Meu Foc.',
  robots = 'index, follow',
  alternates = true,
} = Astro.props;

// idioma según la ruta ("/" español, "/en/" inglés)
const lang = getLang(Astro.currentLocale);
// versiones de esta página en cada idioma (no en páginas sin indexar ni sin traducción, p. ej. admin y eventos)
const indexable = alternates && !robots.includes('noindex');
const hrefEs = new URL(altPath(Astro.url.pathname, 'es'), Astro.site).href;
const hrefEn = new URL(altPath(Astro.url.pathname, 'en'), Astro.site).href;
// imagen para la vista previa al compartir (logo sobre fondo crema, 1200×630)
const ogImage = new URL('/og-el-meu-foc.png', Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- SEO Local -->
  <meta name="robots" content={robots} />
  <link rel="canonical" href={Astro.url.href} />
  {indexable && (
    <>
      <link rel="alternate" hreflang="es" href={hrefEs} />
      <link rel="alternate" hreflang="en" href={hrefEn} />
      <link rel="alternate" hreflang="x-default" href={hrefEs} />
    </>
  )}
  <!-- Verificación de propiedad en Google Search Console -->
  <meta name="google-site-verification" content="yEoJFVlwHKU42_esjbIiZqWp8D3HpibPUGHJaiSdaAU" />
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
  <meta property="og:site_name" content="El Meu Foc" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Logo de El Meu Foc, restaurante de arroces y brasas en Alicante" />
  <!-- Vista previa en Twitter/X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet" />
  <!-- SEO Local: datos estructurados -->
  <RestaurantSchema lang={lang} />
</head>
<body>
  <slot />
  <CookieConsent lang={lang} />
  <GoogleAnalytics />
</body>
</html>
